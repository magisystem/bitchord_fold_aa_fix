+    /**
+     * [fold-mods] Local music grouped for Auto, kept for a minute: every level
+     * of artist → album → song is a separate browse, and each would otherwise
+     * rescan MediaStore.
+     */
+    @Volatile
+    private var autoLocalLibraryCache: Pair<Long, AutoLocalLibrary.Library>? = null
+    private val autoLocalLibraryMutex = Mutex()
+
+    private suspend fun autoLocalLibrary(): AutoLocalLibrary.Library = autoLocalLibraryMutex.withLock {
+        val now = SystemClock.elapsedRealtime()
+        autoLocalLibraryCache?.let { (at, library) -> if (now - at < 60_000L) return library }
+        val songs = LocalMediaRepository.getLocalMusic(this)
+        AutoLocalLibrary.build(songs).also { autoLocalLibraryCache = now to it }
+    }
+
+    private fun MediaItem.withArtwork(url: String?): MediaItem {
+        val uri = url.artworkAt(NOTIFICATION_ART_PX)?.let(Uri::parse) ?: return this
+        return buildUpon().setMediaMetadata(mediaMetadata.buildUpon().setArtworkUri(uri).build()).build()
+    }
+
+    private fun autoLocalArtistName(artist: AutoLocalLibrary.Artist): String =
+        artist.name ?: getString(R.string.fold_auto_various_artists)
+
+    private fun autoLocalCounts(albums: Int, songs: Int): String {
+        val songText = resources.getQuantityString(R.plurals.fold_auto_songs, songs, songs)
+        return if (albums > 0) {
+            resources.getQuantityString(R.plurals.fold_auto_albums, albums, albums) + " · " + songText
+        } else {
+            songText
+        }
+    }
+
+    private fun autoLocalAllItem(library: AutoLocalLibrary.Library?): MediaItem =
+        createFolderItem(
+            AutoLocalLibrary.ALL_ID,
+            getString(R.string.fold_auto_all_songs),
+            subtitle = library?.let { autoLocalCounts(0, it.songs.size) },
+            folderType = MediaMetadata.FOLDER_TYPE_TITLES,
+        )
+
+    private fun autoLocalArtistItem(artist: AutoLocalLibrary.Artist): MediaItem =
+        createFolderItem(
+            artist.id,
+            autoLocalArtistName(artist),
+            subtitle = autoLocalCounts(artist.albumCount, artist.songCount),
+            folderType = MediaMetadata.FOLDER_TYPE_ALBUMS,
+            isGrid = true,
+        ).withArtwork(artist.artUrl)
+
+    private fun autoLocalAlbumItem(artist: AutoLocalLibrary.Artist?, album: AutoLocalLibrary.Album): MediaItem =
+        createFolderItem(
+            album.id,
+            album.title ?: getString(R.string.fold_auto_other_songs),
+            subtitle = artist?.let(::autoLocalArtistName),
+            folderType = MediaMetadata.FOLDER_TYPE_TITLES,
+        ).withArtwork(album.artUrl)
+
+    /**
+     * The "Local music" tile at the head of Auto's Playlists grid. It never
+     * scans the device itself — that would hold up the playlists behind it —
+     * but takes a cover from a scan already made and starts one for next time.
+     */
+    private fun autoLocalShortcutItem(): MediaItem {
+        val cached = autoLocalLibraryCache?.second
+        if (cached == null) scope.launch(Dispatchers.IO) { runCatching { autoLocalLibrary() } }
+        val art = cached?.artists?.firstNotNullOfOrNull { it.artUrl }
+        return createFolderItem(MEDIA_LOCAL_MUSIC_ID, getString(R.string.local_music)).withArtwork(art)
+    }
+
+    /** Children of Auto's Local music folders; null for any other id. */
+    private suspend fun autoLocalChildren(parentId: String): List<MediaItem>? {
+        if (parentId != MEDIA_LOCAL_MUSIC_ID && !AutoLocalLibrary.isLocalFolder(parentId)) return null
+        val library = autoLocalLibrary()
+        library.songs.forEach { songCache[it.videoId] = it }
+        return when {
+            parentId == MEDIA_LOCAL_MUSIC_ID ->
+                if (library.songs.isEmpty()) {
+                    listOf(
+                        createInfoItem(
+                            "msg:empty_local",
+                            getString(R.string.auto_empty_offline_title),
+                            getString(R.string.auto_empty_offline_subtitle),
+                        ),
+                    )
+                } else {
+                    listOf(autoLocalAllItem(library)) + library.artists.map(::autoLocalArtistItem)
+                }
+            parentId.startsWith(AutoLocalLibrary.ARTIST_PREFIX) -> {
+                val artist = library.artist(parentId)
+                artist?.albums?.map { autoLocalAlbumItem(artist, it) }.orEmpty()
+            }
+            else -> library.songsFor(parentId).orEmpty().map { it.toMediaItem() }
+        }
+    }
+
+    /** Auto's Local music folder ids as items, for [MediaLibraryCallback.onGetItem]. */
+    private suspend fun autoLocalItem(mediaId: String): MediaItem? {
+        if (!AutoLocalLibrary.isLocalFolder(mediaId)) return null
+        val library = autoLocalLibrary()
+        return when {
+            mediaId == AutoLocalLibrary.ALL_ID -> autoLocalAllItem(library)
+            mediaId.startsWith(AutoLocalLibrary.ARTIST_PREFIX) -> library.artist(mediaId)?.let(::autoLocalArtistItem)
+            else -> {
+                val album = library.album(mediaId) ?: return null
+                autoLocalAlbumItem(library.artists.firstOrNull { album in it.albums }, album)
+            }
+        }
+    }
+
