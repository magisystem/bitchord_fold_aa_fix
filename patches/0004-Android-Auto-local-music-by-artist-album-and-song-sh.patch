@@ -0,0 +1,128 @@
+package com.music.bitchord.playback
+
+import android.net.Uri
+import com.music.bitchord.data.model.Song
+import java.text.Collator
+import java.util.Locale
+
+/**
+ * [fold-mods] The device's own music, arranged for Android Auto the way a
+ * music library is browsed: artist, then album, then the album's tracks in
+ * order.
+ *
+ * Stock BitChord hands Auto the whole local library as one flat list sorted by
+ * title, which is unusable past a few dozen songs.
+ *
+ * Grouping rules:
+ * - An album is the tracks sharing an album name and album art id, so two
+ *   different "Greatest Hits" stay apart.
+ * - It is filed under the artist most of its tracks credit, with "feat." guests
+ *   ignored for the vote; with no majority it goes under "Various artists".
+ * - Tracks with no album go into an "Other songs" entry under their artist.
+ *
+ * The ids are built from names rather than positions, so one Auto browses
+ * across a rebuild of the library still lands on the same folder.
+ */
+internal object AutoLocalLibrary {
+    const val ALL_ID = "local_all"
+    const val ARTIST_PREFIX = "local_artist:"
+    const val ALBUM_PREFIX = "local_album:"
+
+    private const val VARIOUS_KEY = "~various"
+    private const val LOOSE_KEY = "~loose"
+
+    /** [title] null: the artist's tracks with no album. */
+    class Album(val id: String, val title: String?, val songs: List<Song>) {
+        val artUrl: String? get() = songs.firstNotNullOfOrNull { it.thumbnailUrl }
+    }
+
+    /** [name] null: "Various artists". */
+    class Artist(val id: String, val name: String?, val albums: List<Album>) {
+        val songCount: Int get() = albums.sumOf { it.songs.size }
+        val albumCount: Int get() = albums.count { it.title != null }
+        val artUrl: String? get() = albums.firstNotNullOfOrNull { it.artUrl }
+    }
+
+    class Library(val songs: List<Song>, val artists: List<Artist>) {
+        private val byArtist = artists.associateBy { it.id }
+        private val byAlbum = artists.flatMap { it.albums }.associateBy { it.id }
+
+        fun artist(id: String): Artist? = byArtist[id]
+        fun album(id: String): Album? = byAlbum[id]
+
+        /** Every song a folder id stands for, in playing order; null if not ours. */
+        fun songsFor(id: String): List<Song>? = when {
+            id == ALL_ID -> songs
+            id.startsWith(ARTIST_PREFIX) -> artist(id)?.albums?.flatMap { it.songs }
+            id.startsWith(ALBUM_PREFIX) -> album(id)?.songs
+            else -> null
+        }
+    }
+
+    fun isLocalFolder(id: String): Boolean =
+        id == ALL_ID || id.startsWith(ARTIST_PREFIX) || id.startsWith(ALBUM_PREFIX)
+
+    fun build(songs: List<Song>): Library {
+        val collator = Collator.getInstance().apply { strength = Collator.PRIMARY }
+        val trackOrder = compareBy<Song> { it.trackNumber ?: Int.MAX_VALUE }
+            .thenBy(collator) { it.title }
+
+        class Group(val artistKey: String, val artistName: String?, val albumKey: String, val title: String?, val songs: List<Song>)
+
+        val groups = mutableListOf<Group>()
+        val (withAlbum, loose) = songs.partition { !it.albumName.isNullOrBlank() }
+
+        withAlbum.groupBy(::albumKey).forEach { (key, tracks) ->
+            val artist = albumArtist(tracks)
+            groups += Group(
+                artistKey = artist?.let(::artistKey) ?: VARIOUS_KEY,
+                artistName = artist,
+                albumKey = key,
+                title = tracks.first().albumName!!.trim(),
+                songs = tracks.sortedWith(trackOrder),
+            )
+        }
+        loose.groupBy { artistKey(leadArtist(it.artist)) }.forEach { (key, tracks) ->
+            groups += Group(
+                artistKey = key,
+                artistName = leadArtist(tracks.first().artist),
+                albumKey = LOOSE_KEY,
+                title = null,
+                songs = tracks.sortedWith(compareBy<Song, String>(collator) { it.title }),
+            )
+        }
+
+        val artists = groups.groupBy { it.artistKey }.map { (key, albums) ->
+            val encodedArtist = Uri.encode(key)
+            Artist(
+                id = ARTIST_PREFIX + encodedArtist,
+                name = albums.firstNotNullOfOrNull { it.artistName },
+                albums = albums
+                    .sortedWith(compareBy<Group> { it.title == null }.thenBy(collator) { it.title.orEmpty() })
+                    .map { Album(ALBUM_PREFIX + encodedArtist + "/" + Uri.encode(it.albumKey), it.title, it.songs) },
+            )
+        }.sortedWith(compareBy<Artist> { it.name == null }.thenBy(collator) { it.name.orEmpty() })
+
+        return Library(songs, artists)
+    }
+
+    private fun albumKey(song: Song): String {
+        val artId = song.thumbnailUrl?.substringAfterLast("albumart/", "").orEmpty()
+        return artId + "|" + song.albumName.orEmpty().trim().lowercase(Locale.ROOT)
+    }
+
+    private fun artistKey(name: String): String = name.trim().lowercase(Locale.ROOT)
+
+    /** The credited artist without "feat." guests: "A feat. B" and "A (ft. B)" are both "A". */
+    private fun leadArtist(name: String): String =
+        name.split(FEATURING, limit = 2).first().trim().ifBlank { name.trim() }
+
+    /** The artist most of an album's tracks credit, or null if none has a majority. */
+    private fun albumArtist(tracks: List<Song>): String? {
+        val votes = tracks.map { leadArtist(it.artist) }.groupBy(::artistKey)
+        val top = votes.values.maxByOrNull { it.size } ?: return null
+        return if (top.size * 2 > tracks.size) top.first() else null
+    }
+
+    private val FEATURING = Regex("""\s*[(\[]?\s*\b(feat\.?|ft\.|featuring)\s+""", RegexOption.IGNORE_CASE)
+}
