From ba51d42f590ade70debe6bbdc3e48ebcc7f7dce6 Mon Sep 17 00:00:00 2001
From: Davide Martelli <reg+ia@davidemartelli.dev>
Date: Tue, 10 Nov 2026 22:33:28 +0100
Subject: [PATCH 6/6] Android Auto: Playlists folder survives a slow connection

The playlists fetch gave up after 3 s, which a car on mobile data easily
misses, and the folder then stayed on "No playlists available". Allow 8 s,
and when it still comes back empty keep fetching in the background and
refresh the folder in place once the list arrives.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014ZLg5hgq5iTvbfjb7JLYDe
---
 .../com/music/bitchord/playback/PlaybackService.kt    | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
index 04a06c6..3313dcf 100644
--- a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
+++ b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
@@ -601,7 +601,9 @@ class PlaybackService : MediaLibraryService() {
     private val PLAYLISTS_CACHE_TTL_MS = 60_000L
 
     private suspend fun fetchPlaylistCards(): List<ShelfItem> = try {
-        withTimeoutOrNull(3_000L) {
+        // [fold-mods] 3 s was too short on a car's mobile data: the folder came
+        // up as "No playlists available" while the list was still on its way.
+        withTimeoutOrNull(8_000L) {
             YtMusicRepository.libraryPlaylists().getOrNull()
                 ?: YtMusicRepository.userPlaylists().getOrNull()?.map {
                     ShelfItem(
@@ -9026,6 +9028,13 @@ class PlaybackService : MediaLibraryService() {
                         } else {
                             cachedPlaylistCards()
                         }
+                        if (playlists.isEmpty()) {
+                            // [fold-mods] Keep trying behind the message, and
+                            // fill the folder in place once the list arrives.
+                            refreshFolderInBackground(session, browser, parentId, params) {
+                                cachedPlaylistCards().size
+                            }
+                        }
                         if (playlists.isNotEmpty()) playlists.map(::shelfToGridPlaylistItem) else listOf(
                             createInfoItem(
                                 "msg:empty_playlists",
-- 
2.43.0

