From 6471ebc0b0fdf344a8dfd6bccf47143ffefec690 Mon Sep 17 00:00:00 2001
From: Davide Martelli <reg+ia@davidemartelli.dev>
Date: Tue, 10 Nov 2026 23:10:39 +0100
Subject: [PATCH 7/8] Android Auto: folder icon for Local music

Local music had no artwork in Auto, so its tile in the Playlists grid and
its row under More were blank. It now carries a white folder on a blue
gradient, the same Material folder the phone app shows for Local music,
served from the app's own resources by an android.resource URI.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014ZLg5hgq5iTvbfjb7JLYDe
---
 .../bitchord/playback/PlaybackService.kt      |  31 +++++++++++++++---
 .../drawable-nodpi/fold_auto_local_music.png  | Bin 0 -> 8259 bytes
 2 files changed, 26 insertions(+), 5 deletions(-)
 create mode 100644 app/src/main/res/drawable-nodpi/fold_auto_local_music.png

diff --git a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
index 3313dcf..a26c853 100644
--- a/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
+++ b/app/src/main/java/com/music/bitchord/playback/PlaybackService.kt
@@ -408,10 +408,31 @@ class PlaybackService : MediaLibraryService() {
      * but takes a cover from a scan already made and starts one for next time.
      */
     private fun autoLocalShortcutItem(): MediaItem {
-        val cached = autoLocalLibraryCache?.second
-        if (cached == null) scope.launch(Dispatchers.IO) { runCatching { autoLocalLibrary() } }
-        val art = cached?.artists?.firstNotNullOfOrNull { it.artUrl }
-        return createFolderItem(MEDIA_LOCAL_MUSIC_ID, getString(R.string.local_music)).withArtwork(art)
+        if (autoLocalLibraryCache == null) scope.launch(Dispatchers.IO) { runCatching { autoLocalLibrary() } }
+        return autoLocalMusicFolderItem()
+    }
+
+    /**
+     * [fold-mods] Local music as a folder with its own folder icon, wherever
+     * Auto lists it. The icon goes by an android.resource URI, which Auto reads
+     * out of this app's package like any other artwork.
+     */
+    private fun autoLocalMusicFolderItem(): MediaItem {
+        val icon = R.drawable.fold_auto_local_music
+        val uri = Uri.Builder()
+            .scheme(android.content.ContentResolver.SCHEME_ANDROID_RESOURCE)
+            .authority(packageName)
+            .appendPath(resources.getResourceTypeName(icon))
+            .appendPath(resources.getResourceEntryName(icon))
+            .build()
+        val item = createFolderItem(
+            MEDIA_LOCAL_MUSIC_ID,
+            getString(R.string.local_music),
+            folderType = MediaMetadata.FOLDER_TYPE_MIXED,
+        )
+        return item.buildUpon()
+            .setMediaMetadata(item.mediaMetadata.buildUpon().setArtworkUri(uri).build())
+            .build()
     }
 
     /** Children of Auto's Local music folders; null for any other id. */
@@ -8924,7 +8945,7 @@ class PlaybackService : MediaLibraryService() {
                 )
                 MEDIA_MORE_ID -> listOf(
                     createFolderItem(MEDIA_DOWNLOADS_ID, getString(R.string.downloads), folderType = MediaMetadata.FOLDER_TYPE_MIXED),
-                    createFolderItem(MEDIA_LOCAL_MUSIC_ID, getString(R.string.local_music), folderType = MediaMetadata.FOLDER_TYPE_MIXED),
+                    autoLocalMusicFolderItem(), // [fold-mods]
                 )
                 MEDIA_RECENTS_ID -> {
                     val snapshot = snapshotRecents()
diff --git a/app/src/main/res/drawable-nodpi/fold_auto_local_music.png b/app/src/main/res/drawable-nodpi/fold_auto_local_music.png
new file mode 100644
