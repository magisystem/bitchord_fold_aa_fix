+/**
+ * [fold-mods] Songs by file name as a file manager orders them: runs of digits
+ * compare as numbers, so "2 Song" precedes "10 Song". Rows with no path last.
+ */
+private object FileNameOrder : Comparator<Song> {
+    private val chunks = Regex("""\d+|\D+""")
+
+    private fun Song.fileName(): String? =
+        localPath?.replace('\\', '/')?.substringAfterLast('/')?.lowercase(Locale.ROOT)
+
+    override fun compare(a: Song, b: Song): Int {
+        val x = a.fileName()
+        val y = b.fileName()
+        if (x == null || y == null) return compareValues(x == null, y == null)
+        val xs = chunks.findAll(x).map { it.value }.toList()
+        val ys = chunks.findAll(y).map { it.value }.toList()
+        for (i in 0 until minOf(xs.size, ys.size)) {
+            val p = xs[i]
+            val q = ys[i]
+            val diff = if (p[0].isDigit() && q[0].isDigit()) {
+                val byValue = p.trimStart('0').length.compareTo(q.trimStart('0').length)
+                if (byValue != 0) byValue else p.trimStart('0').compareTo(q.trimStart('0'))
+            } else {
+                p.compareTo(q)
+            }
+            if (diff != 0) return diff
+        }
+        return xs.size.compareTo(ys.size)
+    }
+}
